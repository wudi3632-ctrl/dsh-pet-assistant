{
  "name": "dsh-dashifeiyu-pet",
  "version": "0.3.2",
  "type": "module",
  "description": "DSH专用桌宠插件：原创角色、语音输入、动作气泡与DSH任务执行",
  "scripts": {
    "start": "node server.mjs",
    "desktop": "node scripts/desktop.mjs",
    "test": "node --test tests/*.test.mjs",
    "setup": "node scripts/install.mjs",
    "doctor": "node scripts/doctor.mjs",
    "release:local": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.3"
  },
  "devDependencies": {
    "electron": "43.3.0"
  },
  "main": "./dsh/index.mjs",
  "exports": {
    ".": "./dsh/index.mjs",
    "./client": "./dsh/client.js",
    "./package.json": "./package.json",
    "./host": "./dsh/host.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "files": [
    "dsh/*.mjs",
    "dsh/*.js",
    "cordis.patch.yml",
    "dsh-bridge/index.mjs",
    "desktop/*.cjs",
    "public/*.mjs",
    "public/*.js",
    "public/*.html",
    "public/*.css",
    "public/assets/motions",
    "public/assets/motions.json",
    "public/assets/placeholder.svg",
    "characters/*.mjs",
    "backends/*.mjs",
    "plugin/ownership.mjs",
    "server.mjs",
    "scripts/*.mjs",
    "scripts/setup-speech.py",
    "install.ps1",
    "settings.example.json",
    "README.md",
    "INSTALL.md",
    "CHARACTERS.md",
    "AGENTS.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE",
    "tests/*.test.mjs",
    "tests/test_setup_speech.py",
    "icon.png",
    "ACCEPTANCE.md",
    "speech/*.mjs",
    "speech/*.py",
    "speech/*.json",
    "speech/*.txt"
  ],
  "icon": "./icon.png",
  "license": "MIT"
}
